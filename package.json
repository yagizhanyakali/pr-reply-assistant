{
  "name": "pr-reply-assistant",
  "displayName": "pr-reply-assistant",
  "description": "Instantly generate context-aware replies to pull request comments using AI.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:pr-reply-assistant.draftReply",
    "onChatParticipant:pr-reply-assistant.participant"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pr-reply-assistant.draftReply",
        "title": "Draft PR Reply",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "comments/comment/title": [
        {
          "command": "pr-reply-assistant.draftReply",
          "group": "inline"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "pr-reply-assistant.participant",
        "name": "prreply",
        "fullName": "PR Reply Assistant",
        "description": "Draft concise, constructive replies for pull request comments.",
        "isSticky": true
      }
    ],
    "problemMatchers": [
      {
        "name": "esbuild-watch",
        "label": "esbuild-watch",
        "owner": "typescript",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^✘ \\[ERROR\\] (.*)$",
            "message": 1
          },
          {
            "regexp": "^    (.+):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started$",
          "endsPattern": "^\\[watch\\] build finished$"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
